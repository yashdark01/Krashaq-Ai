# LLM Provider Configuration
LLM_PROVIDER=groq
LLM_FALLBACK_CHAIN=groq,gemini,xai,ollama
LLM_PROVIDER_TIMEOUT_SECONDS=12

# Primary Fallback Chain Providers
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-1.5-pro
XAI_API_KEY=your_xai_api_key_here
XAI_MODEL=xai-reasoner
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b

# Optional Providers (outside primary chain)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-3-haiku-20240307

# Database
DATABASE_URL=sqlite:///./krashaq.db

# Weather API
WEATHER_API_KEY=your_weather_api_key_here

# Twilio Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=your_twilio_whatsapp_number

# JWT Configuration
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=1200

# LangSmith Configuration
LANGCHAIN_API_KEY=your_langchain_api_key
LANGCHAIN_PROJECT=krashaq
LANGCHAIN_TRACING_V2=true

# Sentry Configuration
SENTRY_DSN=your_sentry_dsn

# Email Configuration
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=your_sendgrid_api_key
MAILGUN_API_KEY=your_mailgun_api_key
EMAIL_FROM=noreply@krashaq.com
