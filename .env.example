# Krashaq — copy to .env.local (dev) or Vercel Environment Variables (production)
# NEVER commit this file with real secrets to git.

# ── App URLs (production) ────────────────────────────────────────
# NEXT_PUBLIC_SITE_URL=https://krashaq-agritech.vercel.app
APP_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_REDIRECT_URI=https://krashaq-agritech.vercel.app/auth/callback
# Do NOT set NEXT_PUBLIC_API_URL in monolith mode

# ── Database (use MongoDB Atlas in production) ───────────────────
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=krashaq

# Agent runtime (langgraph = LLM tool-calling ReAct agent)
USE_LANGGRAPH_AGENT=true
AGENT_RUNTIME=langgraph
MFA_TOKEN_EXPIRE_MINUTES=5
MCP_API_KEY=

# ── Demo accounts (local dev — run: npm run db:reset) ───────────
# Admin:    admin@krashaq.dev    / Admin@12345
# Supplier: supplier@krashaq.dev / Supplier@12345
# Farmer:   farmer@krashaq.dev   / Farmer@12345

# ── Auth ─────────────────────────────────────────────────────────
JWT_SECRET_KEY=dev-change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Email (optional — logs to console if SMTP unset) ─────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Krashaq <noreply@krashaq.app>

# ── LLM (Groq default) ───────────────────────────────────────────
LLM_PROVIDER=groq
LLM_FALLBACK_CHAIN=gemini,openai,anthropic
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
XAI_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434

# ── LangSmith tracing (optional — server-only) ───────────────────
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=krashaq-dev

# ── Embeddings (optional — vector RAG; keyword search works without) ─
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small

# ── Tavily web search (schemes, MSP, latest advisories) ──────────
TAVILY_API_KEY=
TAVILY_MAX_RESULTS=5

# ── Weather ──────────────────────────────────────────────────────
WEATHER_API_KEY=

# ── Cache (optional — Upstash Redis on Vercel) ───────────────────
REDIS_URL=

# ── Cron (Vercel — alert delivery) ───────────────────────────────
# CRON_SECRET=generate-a-random-string

# ── Google OAuth server-side ─────────────────────────────────────
# GOOGLE_CLIENT_SECRET=
