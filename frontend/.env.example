# Krashaq — copy to .env.local (dev) or Vercel Environment Variables (production)
# NEVER commit this file with real secrets to git.

# ── App URLs (production) ────────────────────────────────────────
# NEXT_PUBLIC_SITE_URL=https://krashaq-agritech.vercel.app
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_REDIRECT_URI=https://krashaq-agritech.vercel.app/auth/callback
# Do NOT set NEXT_PUBLIC_API_URL in monolith mode

# ── Database (use MongoDB Atlas in production) ───────────────────
MONGODB_URL=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/krashaq_ai?retryWrites=true&w=majority
MONGODB_DB=krashaq_ai

# ── Auth ─────────────────────────────────────────────────────────
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── LLM (Groq default) ───────────────────────────────────────────
LLM_PROVIDER=groq
LLM_FALLBACK_CHAIN=gemini,openai,anthropic
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
XAI_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434

# ── Weather ──────────────────────────────────────────────────────
WEATHER_API_KEY=

# ── Cache (optional — Upstash Redis on Vercel) ───────────────────
REDIS_URL=

# ── Legacy FastAPI bridge (optional) ───────────────────────────────
# LEGACY_PYTHON_URL=

# ── Google OAuth server-side (legacy backend) ─────────────────────
# GOOGLE_CLIENT_SECRET=
