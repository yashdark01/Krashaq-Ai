{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@/components/ErrorBoundary": ["./modules/common/components/ErrorBoundary"],
      "@/components/FarmerForm": ["./modules/farmers/components/FarmerForm"],
      "@/components/admin/*": ["./modules/admin/components/*"],
      "@/components/auth/*": ["./modules/auth/components/*"],
      "@/components/chat/*": ["./modules/conversation/components/*"],
      "@/components/dashboard/*": ["./modules/common/components/dashboard/*"],
      "@/components/layout/*": ["./modules/common/components/layout/*"],
      "@/components/theme/*": ["./modules/common/components/theme/*"]
    },
    "target": "ES2017"
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "types/**/*.d.ts"
  ],
  "exclude": ["node_modules"]
}
